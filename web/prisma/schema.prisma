generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Dono da barbearia (gerencia tudo)
model Owner {
  id               String    @id @default(cuid())
  name             String
  phone            String    @unique
  passwordHash     String
  // Codigo de recuperacao (hash) para redefinir a senha sem depender do suporte
  recoveryCodeHash String?
  // Aceite dos termos.
  //
  // Checkbox que ninguem registra nao prova nada: se um dia houver disputa,
  // o que vale e QUANDO a pessoa aceitou e QUAL versao estava no ar naquele
  // dia. Guardar a versao permite mostrar o texto exato que ela leu.
  termsAcceptedAt  DateTime?
  termsVersion     String?
  createdAt        DateTime  @default(now())

  shops Shop[]

  @@map("owners")
}

// A barbearia (estabelecimento)
model Shop {
  id             String    @id @default(cuid())
  ownerId        String
  name           String
  slug           String    @unique
  openTime       String // "08:00"
  closeTime      String // "20:00"
  workDays       Int[] // [1,2,3,4,5,6]
  avgServiceTime Int       @default(30) // minutos, para calcular limite diario
  /// De quanto em quanto tempo a agenda oferece horario: 15, 20, 30, 45 ou 60.
  /// Barbearia que atende 1h por cliente nao quer oferecer 08:30 — quer
  /// 08:00, 09:00, 10:00. Antes disso o passo era fixo em 30 no codigo.
  slotInterval   Int       @default(30)

  /// Quantos dias para frente o CLIENTE enxerga no link publico.
  ///
  /// Serve para o barbeiro que nao quer o mes inteiro aberto: agenda longe
  /// demais enche de marcacao que ninguem lembra e vira falta. Nao vale
  /// para o painel — o barbeiro marca no balcao para quando quiser.
  ///
  /// 30 e o padrao porque era o numero fixo que estava no codigo: assim
  /// nenhuma barbearia existente muda de comportamento sozinha.
  diasAbertos    Int       @default(30)
  pixKey         String? // chave pix manual (usada quando o Mercado Pago nao esta conectado)
  // Mercado Pago: quando conectado, o Pix vira automatico — o dinheiro cai
  // direto na conta da barbearia e o sistema confirma sozinho via webhook.
  mpAccessToken  String?
  mpRefreshToken String?
  mpUserId       String?
  mpConnectedAt  DateTime?
  logoUrl        String? // logo da barbearia (URL no Supabase Storage) — aparece no link do cliente
  // Onde a barbearia fica e como falar com ela. Tudo opcional: as barbearias
  // que ja existem foram criadas sem esses campos e precisam continuar
  // funcionando. Aparecem no link publico para o cliente saber o endereco.
  phone          String? // telefone/WhatsApp publico da barbearia
  address        String? // rua e numero
  neighborhood   String? // bairro
  city           String?
  state          String? // UF
  zipCode        String? // CEP
  colorTheme     String    @default("midnight_gold") // paleta de cores escolhida
  bookingMode    String    @default("steps") // "steps" (etapas) ou "agent" (agente IA chat)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  owner          Owner                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  barbers        Barber[]
  services       Service[]
  appointments   Appointment[]
  recurring      RecurringAppointment[]
  products       Product[]
  loyalties      LoyaltyCount[]
  blockedSlots   BlockedSlot[]
  waitlist       Waitlist[]
  banned         BannedClient[]
  subscription   Subscription?
  despesas       Expense[]
  bloqueiosFixos RecurringBlock[]
  mensagens      InboundMessage[]
  expediente     WorkDay[]

  @@map("shops")
}

// Profissional (barbeiro)
model Barber {
  id               String   @id @default(cuid())
  shopId           String
  name             String
  phone            String
  // E-mail do profissional. Opcional e sem uso automatico ainda: e a base
  // para recuperar a senha sem depender do WhatsApp, quando houver envio.
  email            String?
  // Foto do profissional — aparece para o cliente na hora de escolher com
  // quem cortar. E a razao de o dono tambem ter um perfil de barbeiro.
  imageUrl         String?
  passwordHash     String
  // Codigo de recuperacao (hash) para redefinir a senha sem depender do dono
  recoveryCodeHash String?
  active           Boolean  @default(true)
  role             String   @default("barber") // "barber" | "owner"
  isOwnerProfile   Boolean  @default(false) // true = perfil do dono para gerenciar própria agenda
  pushToken        String? // Expo Push Token para notificacoes
  commission       Float    @default(0) // % comissão sobre serviços (ex: 10 = 10%)
  /// Quando o resumo da agenda foi mandado para o WhatsApp dele.
  ///
  /// O cron da Vercel roda 1x/dia, mas o agendador externo bate mais vezes —
  /// sem esta marca o barbeiro recebe a mesma lista quatro vezes de manha, e
  /// cada copia e uma mensagem paga.
  agendaEnviadaEm  DateTime?
  createdAt        DateTime @default(now())

  shop           Shop                   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  appointments   Appointment[]
  recurring      RecurringAppointment[]
  blockedSlots   BlockedSlot[]
  waitlist       Waitlist[]
  pushSubs       PushSubscription[]
  bloqueiosFixos RecurringBlock[]

  @@unique([shopId, phone])
  @@map("barbers")
}

// Inscricoes de notificacao do navegador (Web Push) — PWA do barbeiro/dono.
// Um registro por aparelho, para o mesmo barbeiro receber no celular e no PC.
model PushSubscription {
  id        String   @id @default(cuid())
  barberId  String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId])
  @@map("push_subscriptions")
}

// Eventos anonimos de uso do link publico — base do funil de conversao.
// Nao guarda nada que identifique a pessoa: so um id de sessao aleatorio
// gerado no navegador, que morre quando a aba fecha.
model ShopEvent {
  id        String   @id @default(cuid())
  shopId    String
  type      String // "view" = abriu o link | "book" = concluiu o agendamento
  sessionId String
  createdAt DateTime @default(now())

  @@index([shopId, createdAt])
  @@index([shopId, type, sessionId])
  @@map("shop_events")
}

// Codigo de uso unico enviado por WhatsApp para redefinir a senha.
// Guardamos so o hash: se o banco vazar, os codigos nao servem para nada.
model PasswordReset {
  id        String    @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([phone, createdAt])
  @@map("password_resets")
}

// Servicos da barbearia
model Service {
  id       String  @id @default(cuid())
  shopId   String
  name     String
  duration Int
  price    Decimal @db.Decimal(10, 2)
  category String // "corte","barba","sobrancelha","pezinho","luzes"
  imageUrl String?
  active   Boolean @default(true)

  shop         Shop                          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  appointments AppointmentService[]
  recurring    RecurringAppointmentService[]

  @@map("services")
}

// Produtos vendidos na barbearia
model Product {
  id          String   @id @default(cuid())
  shopId      String
  name        String
  price       Decimal  @db.Decimal(10, 2)
  /// Quanto a barbearia pagou por uma unidade. Opcional porque os produtos
  /// que ja existem foram cadastrados sem ele — sem custo, a tela mostra
  /// "falta o custo" em vez de inventar uma margem.
  custo       Decimal? @db.Decimal(10, 2)
  description String?
  imageUrl    String?
  imageUrl2   String?
  active      Boolean  @default(true)

  shop         Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  comandaItems ComandaItem[]

  @@map("products")
}

// Cliente (identificado por telefone, global)
model Client {
  id          String   @id @default(cuid())
  name        String
  phone       String   @unique
  email       String?
  /// OBSOLETO — nao e mais lido nem escrito em lugar nenhum.
  ///
  /// Era o contador de faltas do TELEFONE, e pai e filho dividem telefone:
  /// a falta do filho cobrava Pix do pai, e o Pix do pai limpava a ficha do
  /// filho. A contagem agora e DERIVADA por pessoa, em `lib/faltas.ts`.
  ///
  /// A coluna ficou para nao exigir migracao de dado num banco em uso.
  noShowCount Int      @default(0)
  notes       String? // notas do barbeiro sobre o cliente (CRM)
  createdAt   DateTime @default(now())

  appointments Appointment[]
  recurring    RecurringAppointment[]
  loyalties    LoyaltyCount[]
  ratings      Rating[]

  @@map("clients")
}

// Agendamento
model Appointment {
  id                  String    @id @default(cuid())
  shopId              String
  barberId            String
  clientId            String
  date                DateTime
  startTime           String
  endTime             String
  totalDuration       Int
  totalPrice          Decimal   @db.Decimal(10, 2)
  status              String    @default("confirmed") // confirmed, completed, cancelled, no_show
  paymentMethod       String? // pix, dinheiro, cartao, adiado
  paidAt              DateTime?
  deferredPaymentDate DateTime?
  reminderSentAt      DateTime?
  // Pré-agendamento (Pix declarado, aguardando o barbeiro confirmar):
  // vence após 6h de barbearia aberta, nunca depois da hora do corte.
  pendingExpiresAt    DateTime?
  // Cobranca Pix criada no Mercado Pago (quando a barbearia esta conectada)
  mpPaymentId         String?   @unique
  mpQrCode            String? // codigo copia-e-cola
  cancelledAt         DateTime?
  cancelledBy         String? // "client" | "barber" | "owner"
  pixRequested        Boolean   @default(false)
  // Ocorrencia gerada por um agendamento recorrente. Nulo = agendamento avulso.
  recurringId         String?

  /// Nome digitado NA HORA de marcar.
  ///
  /// `Client` e global e a chave e o telefone, entao pai e filho que usam o
  /// mesmo numero sao o MESMO cliente. Sem congelar aqui, marcar o segundo
  /// renomeava o agendamento do primeiro — e o de todas as lojas.
  ///
  /// Nulo = linha antiga; nesse caso vale o nome do `Client`.
  clientName          String?

  /// Falta perdoada quando o cliente pagou o Pix da penalidade.
  ///
  /// Substitui o antigo `Client.noShowCount = 0`: zerar um contador
  /// apagava a falta do PAI junto com a do filho, e nao deixava rastro de
  /// que houve perdao. Aqui da para ver qual falta foi relevada.
  faltaPerdoada       Boolean   @default(false)

  /// Por que o lembrete NAO saiu, quando nao saiu de proposito.
  ///
  /// "pediu_parar" = o numero pediu para nao receber. Sem esta marca o cron
  /// veria reminderSentAt vazio e tentaria de novo a cada rodada.
  lembretePuladoMotivo String?
  createdAt           DateTime  @default(now())

  shop         Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  barber       Barber                @relation(fields: [barberId], references: [id], onDelete: Cascade)
  client       Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  services     AppointmentService[]
  recurring    RecurringAppointment? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  rating       Rating?
  comandaItems ComandaItem[]

  // Uma regra so pode gerar UMA ocorrencia por dia. E esta trava que torna a
  // materializacao idempotente: ler a agenda duas vezes nao duplica o corte.
  @@unique([recurringId, date])
  @@map("appointments")
}

model AppointmentService {
  id            String @id @default(cuid())
  appointmentId String
  serviceId     String

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("appointment_services")
}

// Avaliacao pos-atendimento
model Rating {
  id            String   @id @default(cuid())
  appointmentId String   @unique
  clientId      String
  shopId        String
  barberId      String
  score         Int // 1-5
  comment       String?
  createdAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("ratings")
}

// Itens da comanda (produtos vendidos no atendimento)
model ComandaItem {
  id            String   @id @default(cuid())
  appointmentId String
  productId     String
  quantity      Int      @default(1)
  price         Decimal  @db.Decimal(10, 2)
  /// Custo no momento da venda, congelado pelo mesmo motivo do preco:
  /// mudar o que se paga ao fornecedor hoje nao pode reescrever a margem
  /// dos meses que ja fecharam.
  custo         Decimal? @db.Decimal(10, 2)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("comanda_items")
}

// Cliente barrado por UMA barbearia.
//
// A chave e o TELEFONE, nao o clientId: o barbeiro pode querer barrar um
// numero que ainda nem agendou, e Client e uma tabela global (o mesmo
// telefone atende varias barbearias). Guardar por telefone + shopId mantem
// o banimento restrito a quem baniu — quem apronta na Dubarber continua
// podendo agendar na HenrBarber.
model BannedClient {
  id        String   @id @default(cuid())
  shopId    String
  phone     String // so digitos
  name      String? // como estava salvo na hora do banimento, para a lista
  reason    String?
  createdAt DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, phone])
  @@index([shopId])
  @@map("banned_clients")
}

// Horarios bloqueados pelo barbeiro
model BlockedSlot {
  id       String   @id @default(cuid())
  barberId String
  shopId   String
  date     DateTime // date only (stored as midnight UTC)
  time     String? // null = dia todo bloqueado, "09:00" = horario especifico

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([barberId, date, time])
  @@map("blocked_slots")
}

// Lista de espera — clientes aguardando vaga
model Waitlist {
  id            String   @id @default(cuid())
  shopId        String
  clientName    String
  clientPhone   String
  barberId      String? // preferência de barbeiro (opcional)
  serviceIds    String[] // serviços desejados
  preferredDate String? // data preferida "YYYY-MM-DD"
  createdAt     DateTime @default(now())

  shop   Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  barber Barber? @relation(fields: [barberId], references: [id], onDelete: SetNull)

  @@map("waitlist")
}

// Fidelidade por cliente por barbearia
model LoyaltyCount {
  id           String    @id @default(cuid())
  shopId       String
  clientId     String
  /// Nome normalizado de QUEM foi atendido. O telefone e da casa; a
  /// fidelidade e da pessoa. Ver `lib/pessoa.ts`.
  pessoa       String    @default("")
  barberId     String? // ultimo barbeiro que atendeu
  count        Int       @default(0)
  lastRewardAt DateTime?
  updatedAt    DateTime  @updatedAt

  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([shopId, clientId, pessoa])
  @@map("loyalty_counts")
}

// ─────────────────────────────────────────────────────────────────────
// Assinatura da barbearia no BarberPro.
//
// Uma por loja. O status é derivado de datas, não escrito na mão:
//   trial      — 14 dias desde o cadastro, sem pedir pagamento
//   ativa      — pagou, dentro do período
//   carencia   — venceu, mas ainda tem acesso total (7 dias de aviso)
//   bloqueada  — acabou a carência: painel só leitura, link fechado
//   cortesia   — não vence (piloto, parceiro, uso interno)
//   cancelada  — desistiu
//
// `metodo` existe desde o começo para o cartão entrar depois sem migração:
// Pix gera uma cobrança por ciclo, cartão usa assinatura recorrente do MP.
// ─────────────────────────────────────────────────────────────────────
model Subscription {
  id     String @id @default(cuid())
  shopId String @unique

  plano  String  @default("mensal") // "mensal" | "semestral" | "anual"
  status String  @default("trial")
  metodo String? // "pix" | "cartao"

  /// Valor do ciclo inteiro (semestral cobra 6x o mensal com desconto).
  valorCiclo  Decimal   @default(79.90) @db.Decimal(10, 2)
  /// Fim do teste grátis. Null quando nunca houve trial.
  trialEndsAt DateTime?
  /// Até quando o acesso está pago. É desta data que tudo é calculado.
  periodoFim  DateTime
  /// Cancelamento pedido pelo dono — o acesso segue até periodoFim.
  canceladaEm DateTime?
  /// Quantas cobranças do compromisso atual já foram pagas.
  ///
  /// Num plano "anual pago todo mês" o barbeiro leva o preço de anual desde
  /// o primeiro mês. Se sair no sexto, usou seis meses de desconto sem
  /// cumprir os doze — este contador é o que permite calcular a diferença.
  /// Zera quando o plano muda, porque aí o compromisso é outro.
  ciclosPagos Int       @default(0)

  /// Assinatura recorrente no Mercado Pago (quando metodo = "cartao").
  mpPreapprovalId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop      Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  cobrancas SubscriptionInvoice[]

  @@index([status])
  @@index([periodoFim])
  @@map("subscriptions")
}

// Cada cobrança gerada. Guardar o histórico é o que permite o dono ver o
// que já pagou e você conferir uma contestação meses depois.
model SubscriptionInvoice {
  id             String @id @default(cuid())
  subscriptionId String

  valor      Decimal   @db.Decimal(10, 2)
  /// Plano que esta fatura cobra. Guardado AQUI, e nao lido da assinatura,
  /// porque o dono pode trocar de plano depois de a cobranca ser gerada — e
  /// o webhook precisa honrar o que foi efetivamente pago, nao o plano atual.
  plano      String    @default("mensal")
  status     String    @default("pendente") // "pendente" | "paga" | "vencida" | "cancelada"
  vencimento DateTime
  pagaEm     DateTime?
  metodo     String?

  /// Quem processou: "infinitepay" ou "mercadopago".
  provedor      String?
  /// Link de checkout que o dono abre para pagar.
  linkPagamento String?
  /// Identificador da transação no provedor — o webhook reencontra por aqui.
  mpPaymentId   String? @unique
  copiaECola    String?
  qrCodeBase64  String?

  /// O rastro da cobranca, para o painel da plataforma mostrar em que passo
  /// cada dono parou. Sem isto so dava para ver "pendente" — e pendente nao
  /// diz se o WhatsApp saiu, nem se ele chegou a abrir o link.
  ///
  /// De onde a fatura nasceu: "cron" (perto do vencimento), "link" (o dono
  /// escolheu o plano em /pagar) ou "painel". Null nas anteriores a isto.
  origem        String?
  /// Quando o aviso foi tentado, e o que saiu: o nome do modelo de WhatsApp,
  /// ou "falhou". Null = ninguem tentou avisar por esta fatura.
  avisadaEm     DateTime?
  avisoWhatsapp String?
  /// Primeira vez que alguem abriu /pagar/{fatura} num navegador.
  abertaEm      DateTime?

  createdAt DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([status, vencimento])
  @@map("subscription_invoices")
}

/// Corte que se repete toda semana no mesmo dia e horario.
///
/// MODELO: guarda a REGRA, nao as ocorrencias. O barbeiro cria uma vez ("toda
/// terca as 10h, ate 31/12") e o sistema materializa cada corte como um
/// Appointment normal quando aquele dia entra no horizonte da agenda.
///
/// Por que materializar em vez de manter tudo virtual: pagamento, falta,
/// comanda, avaliacao e fidelidade se penduram num Appointment de verdade. Uma
/// ocorrencia virtual obrigaria cada uma dessas funcionalidades a entender um
/// segundo formato — e a primeira que esquecesse quebraria em silencio.
///
/// Por que nao criar tudo de uma vez: era exatamente o que o dono queria
/// evitar. Um corte semanal por um ano sao 52 linhas criadas hoje para um
/// compromisso que pode acabar em marco.
model RecurringAppointment {
  id            String   @id @default(cuid())
  shopId        String
  barberId      String
  clientId      String
  /// 0 = domingo ... 6 = sabado
  weekday       Int
  startTime     String
  totalDuration Int
  totalPrice    Decimal  @db.Decimal(10, 2)
  /// Primeira e ultima data em que a regra vale. O fim e obrigatorio: sem ele
  /// o compromisso seria eterno e ninguem lembraria de encerrar.
  startDate     DateTime
  endDate       DateTime
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  shop         Shop                          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  barber       Barber                        @relation(fields: [barberId], references: [id], onDelete: Cascade)
  client       Client                        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  services     RecurringAppointmentService[]
  appointments Appointment[]

  @@index([shopId, barberId, weekday])
  @@map("recurring_appointments")
}

model RecurringAppointmentService {
  id          String @id @default(cuid())
  recurringId String
  serviceId   String

  recurring RecurringAppointment @relation(fields: [recurringId], references: [id], onDelete: Cascade)
  service   Service              @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("recurring_appointment_services")
}

/// Despesa da barbearia.
///
/// O app sempre soube tudo que ENTRA e nada que SAI, entao "quanto sobrou"
/// era impossivel de responder. Isto e o outro lado da conta.
///
/// Recorrencia: a despesa marcada `recorrente` e o MOLDE. Todo mes o cron
/// cria uma copia dela com `origemId` apontando de volta. Aluguel, agua e
/// luz sao 80% das despesas de uma barbearia e nao mudam — se dependessem
/// de digitacao, a tela seria abandonada no segundo mes.
model Expense {
  id         String   @id @default(cuid())
  shopId     String
  descricao  String
  valor      Decimal  @db.Decimal(10, 2)
  /// aluguel | contas | produtos | equipe | manutencao | outros
  /// Lista fechada de proposito: com campo livre, em dois meses existem
  /// "produto", "produtos" e "prod." como categorias diferentes.
  categoria  String
  data       DateTime
  /// Molde de repeticao mensal.
  recorrente Boolean  @default(false)
  /// Preenchido nas copias geradas pelo cron; aponta para o molde.
  origemId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  shop   Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  origem Expense?  @relation("MoldeDaDespesa", fields: [origemId], references: [id], onDelete: SetNull)
  copias Expense[] @relation("MoldeDaDespesa")

  @@index([shopId, data])
  @@index([origemId])
  @@map("expenses")
}

/// Bloqueio que se repete toda semana — o almoço, a folga da quarta.
///
/// Avaliado na hora, e NÃO materializado em BlockedSlot. Bloqueio não tem
/// identidade a preservar como um agendamento tem: gerar linhas todo dia
/// custaria um cron, limpeza e a chance de o barbeiro ver o almoço de um dia
/// que ainda não foi gerado. Aqui a regra é a verdade, e o dia é derivado.
model RecurringBlock {
  id         String   @id @default(cuid())
  shopId     String
  barberId   String
  /// "12:00"
  horaInicio String
  /// "13:00" — exclusivo: um bloqueio 12:00–13:00 libera as 13:00
  horaFim    String
  /// 0=domingo … 6=sábado, a mesma convenção de Shop.workDays
  diasSemana Int[]
  /// Desligar em vez de apagar: a folga de janeiro volta em julho
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now())

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([barberId, ativo])
  @@map("recurring_blocks")
}

/// Mensagem que o CLIENTE mandou para o número do BarberPro.
///
/// Existe porque os lembretes terminam com "é só responder por aqui" e, até
/// aqui, responder não levava a lugar nenhum: número da Cloud API não tem
/// caixa de entrada em canto nenhum — o que não cai num webhook é descartado,
/// não fica "não lido". A mensagem que mais chega é "não vou poder ir", que é
/// exatamente a que evitaria uma falta.
///
/// `waMessageId` é único porque a Meta reenvia o webhook quando não recebe
/// 200 rápido. Sem essa trava, o mesmo "oi" gera duas respostas automáticas.
model InboundMessage {
  id           String    @id @default(cuid())
  /// Id da mensagem na Meta.
  waMessageId  String    @unique
  /// Barbearia deduzida pelo agendamento mais próximo desse telefone.
  /// Nulo quando não deu para saber — a mensagem é guardada assim mesmo.
  shopId       String?
  clientPhone  String
  clientName   String?
  texto        String
  /// text | audio | image | outro — o que não é texto vira um aviso.
  tipo         String    @default("text")
  recebidaEm   DateTime  @default(now())
  lida         Boolean   @default(false)
  respondidaEm DateTime?

  shop Shop? @relation(fields: [shopId], references: [id], onDelete: SetNull)

  @@index([shopId, recebidaEm])
  @@map("inbound_messages")
}

/// Horário de trabalho de UM dia da semana.
///
/// A barbearia tinha um horário só, herdado por todos os dias. Quem abre 13h
/// na terça e 08h na sexta precisava escolher a janela mais larga e bloquear
/// o resto à mão, todo dia — foi assim que este modelo apareceu.
///
/// É da BARBEARIA, não do barbeiro: decisão do dono. Barbeiro com horário
/// próprio continua usando bloqueio recorrente, que já existe e resolve.
///
/// Ausência de linha para um dia significa "ainda não configurado", e aí
/// vale o `openTime`/`closeTime`/`workDays` da loja. É o que mantém as
/// barbearias antigas funcionando sem migração obrigatória.
model WorkDay {
  id           String  @id @default(cuid())
  shopId       String
  /// 0=domingo … 6=sábado, a mesma convenção de Shop.workDays
  dia          Int
  /// Fechado guarda os horários: reabrir não faz digitar de novo.
  aberto       Boolean @default(true)
  abre         String  @default("09:00")
  fecha        String  @default("19:00")
  /// Almoço opcional. Nulo nos dois = dia sem parada.
  almocoInicio String?
  almocoFim    String?

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, dia])
  @@map("work_days")
}

/// Contagem de tentativas que sobrevive ao serverless.
///
/// O limitador do middleware e um Map em memoria, e cada instancia tem o
/// seu: o limite de 10 logins por minuto vira 10 x o numero de instancias,
/// que cresce com a carga que o proprio ataque provoca.
///
/// A chave e a IDENTIDADE (ex.: "login:5511999999999"), nao o IP — quem
/// quer entrar numa conta especifica troca de IP de graca, mas nao troca o
/// telefone do alvo.
model RateLimit {
  chave        String    @id
  tentativas   Int       @default(0)
  janelaAte    DateTime
  /// Quantas vezes ja foi bloqueada: e o que faz o castigo dobrar.
  castigos     Int       @default(0)
  bloqueadoAte DateTime?

  @@index([janelaAte])
  @@map("rate_limits")
}

/// Conversa do robo comercial com um numero. Uma linha por telefone.
///
/// A linha sobrevive ao fim da conversa de proposito: e ela que diz que o
/// numero ja respondeu as 3 perguntas (volta na Oferta) ou que tocou em
/// "Sou cliente" (nao recebe as Boas-vindas de novo por 30 dias).
///
/// A conversa esta aberta enquanto `encerradaEm` for nulo e a ultima mensagem
/// tiver menos de 24h. Ver `lib/robo-fluxo.ts`.
model ConversaComercial {
  /// Telefone canonico: 55 + DDD + 9 + numero. Ver `lib/telefone.ts`.
  telefone               String    @id
  /// Nome do perfil do WhatsApp, para o painel da plataforma.
  nome                   String?
  /// p1 | p2 | p3 | oferta | duvida
  etapa                  String    @default("p1")
  /// instagram | site | barberpro | direto
  origem                 String?
  papel                  String?
  barbeiros              String?
  agenda                 String?
  /// O que o robo nao soube responder, para sabermos o que falta no fluxo.
  perguntasNaoEntendidas String[]
  /// Dois "nao entendi" seguidos levam a uma pessoa.
  naoEntendidasSeguidas  Int       @default(0)
  souClienteEm           DateTime?
  iniciadaEm             DateTime  @default(now())
  ultimaMensagemEm       DateTime  @default(now())
  encerradaEm            DateTime?

  @@index([ultimaMensagemEm])
  @@map("conversas_comerciais")
}

/// Numero que pediu PARAR. A Meta obriga a respeitar o pedido, e ele vale em
/// todas as barbearias: quem pediu nao recebe lembrete nem aviso de vaga.
/// VOLTAR apaga a linha.
model PedidoParar {
  /// Telefone canonico: o pedido chega de um jeito e o cadastro pode estar
  /// de outro (com ou sem 55, com ou sem o 9o digito).
  telefone String   @id
  pedidoEm DateTime @default(now())

  @@map("pedidos_parar")
}
